{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spotdonalds.local/menu.schema.json",
  "title": "SpotDonalds McDonald's Australia menu",
  "type": "object",
  "required": [
    "metadata",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "project",
        "market",
        "retrieved_at",
        "retrieved_at_timezone",
        "sources",
        "notes",
        "coverage_gaps"
      ],
      "additionalProperties": false,
      "properties": {
        "project": {
          "type": "string"
        },
        "market": {
          "type": "string"
        },
        "retrieved_at": {
          "type": "string",
          "description": "ISO-8601 timestamp including offset for Australia/Sydney."
        },
        "retrieved_at_timezone": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "title",
              "url",
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "type": {
                "type": "string",
                "enum": [
                  "product_page",
                  "sitemap",
                  "nutrition_index",
                  "nutrition_pdf",
                  "terms",
                  "robots"
                ]
              },
              "dated": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "coverage_gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "item_count": {
          "type": "integer",
          "minimum": 0
        },
        "item_count_by_category": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "nutrition_coverage": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "present",
              "missing"
            ],
            "additionalProperties": false,
            "properties": {
              "present": {
                "type": "integer",
                "minimum": 0
              },
              "missing": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/menuItem"
      }
    }
  },
  "$defs": {
    "nutrient": {
      "description": "A published number, or null if the official source did not state it. Never invented.",
      "type": [
        "number",
        "null"
      ]
    },
    "nutritionPanel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "energy_kj": {
          "$ref": "#/$defs/nutrient"
        },
        "energy_kcal": {
          "$ref": "#/$defs/nutrient"
        },
        "protein_g": {
          "$ref": "#/$defs/nutrient"
        },
        "fat_g": {
          "$ref": "#/$defs/nutrient"
        },
        "saturated_fat_g": {
          "$ref": "#/$defs/nutrient"
        },
        "carbs_g": {
          "$ref": "#/$defs/nutrient"
        },
        "sugar_g": {
          "$ref": "#/$defs/nutrient"
        },
        "sodium_mg": {
          "$ref": "#/$defs/nutrient"
        }
      }
    },
    "menuItem": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category",
        "url",
        "nutrition_available",
        "energy_kj",
        "energy_kcal",
        "energy_kcal_derived",
        "protein_g",
        "fat_g",
        "carbs_g",
        "sugar_g",
        "sodium_mg",
        "tags",
        "tags_inferred",
        "price_aud"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Stable slug, unique in this dataset. Size is included when the official URL is size-specific."
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "small",
            "medium",
            "large",
            null
          ]
        },
        "category": {
          "type": "string",
          "enum": [
            "burgers",
            "chicken_and_fish",
            "breakfast",
            "sides",
            "desserts",
            "mccafe_drinks",
            "mccafe_food",
            "cold_and_frozen_drinks",
            "shakes_and_frappes",
            "condiments",
            "happy_meal",
            "bundle_meals"
          ]
        },
        "source_category": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "nutrition_available": {
          "type": "boolean"
        },
        "nutrition_source": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "official_product_page",
            "official_nutrition_pdf",
            null
          ]
        },
        "energy_kj": {
          "$ref": "#/$defs/nutrient"
        },
        "energy_kcal": {
          "$ref": "#/$defs/nutrient"
        },
        "energy_kcal_derived": {
          "type": "boolean",
          "description": "True only when energy_kcal was computed as energy_kj / 4.184 because the page did not state Calories."
        },
        "protein_g": {
          "$ref": "#/$defs/nutrient"
        },
        "fat_g": {
          "$ref": "#/$defs/nutrient"
        },
        "saturated_fat_g": {
          "$ref": "#/$defs/nutrient"
        },
        "carbs_g": {
          "$ref": "#/$defs/nutrient"
        },
        "sugar_g": {
          "$ref": "#/$defs/nutrient"
        },
        "sodium_mg": {
          "$ref": "#/$defs/nutrient"
        },
        "per_100": {
          "anyOf": [
            {
              "$ref": "#/$defs/nutritionPanel"
            },
            {
              "type": "null"
            }
          ]
        },
        "serving_size_g": {
          "type": [
            "number",
            "null"
          ]
        },
        "serving_size_derived": {
          "type": "boolean"
        },
        "serving_size_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "availability_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags_inferred": {
          "type": "boolean",
          "description": "Tags are inferred from the official name, description and category, not from a McDonald's tag taxonomy."
        },
        "price_aud": {
          "type": "null",
          "description": "Official national prices are not published; prices vary by restaurant. Always omitted."
        },
        "nutrition_pdf_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "nutrition_pdf_dated": {
          "type": [
            "string",
            "null"
          ]
        },
        "nutrition_note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
