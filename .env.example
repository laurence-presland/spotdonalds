# Supabase project URL. Browser-safe. Already set on Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable key (browser-safe). Already set on Vercel.
# This is the new publishable key, not the legacy anon JWT.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only Supabase secret key. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
# Already set on Vercel for production and preview.
SUPABASE_SECRET_KEY=your-secret-key

# Postgres schema for every SpotDonalds table. Never use public.
# Already set on Vercel.
SUPABASE_DB_SCHEMA=spotdonalds

# Public Spotify client id. Safe to expose. Used when this server refreshes a
# provider token. The value below is the SpotDonalds app.
SPOTIFY_CLIENT_ID=682dcdb2828949ffb8718644e24d3a93

# Server-only Spotify client secret. NOT set on Vercel. The same secret is
# stored in Supabase Auth. Token refresh against Spotify's token endpoint
# needs it here as well, because the app is a confidential client.
# Never prefix with NEXT_PUBLIC_.
SPOTIFY_CLIENT_SECRET=
