# Supabase project URL. Browser-safe. Already set on Vercel.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase publishable key (browser-safe). Already set on Vercel.
# This is the new publishable key, not the legacy anon JWT.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Direct Postgres connection for server data access. Sensitive. Already set on Vercel
# for production and preview. It uses the Supavisor transaction pooler (port 6543)
# as spotdonalds_app, with sslmode=require. Never prefix with NEXT_PUBLIC_.
# The password is set out of band. Do not commit a real value.
DATABASE_URL=postgres://spotdonalds_app.your-project-ref:password@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Public Spotify client id. Safe to expose. Used when this server refreshes a
# provider token. The value below is the SpotDonalds app.
SPOTIFY_CLIENT_ID=682dcdb2828949ffb8718644e24d3a93

# Server-only Spotify client secret. NOT set on Vercel. The same secret is
# stored in Supabase Auth. Token refresh against Spotify's token endpoint
# needs it here as well, because the app is a confidential client.
# Never prefix with NEXT_PUBLIC_.
SPOTIFY_CLIENT_SECRET=

# MusicBrainz requires a User-Agent with an app name and a contact.
# Not set on Vercel; the server falls back to SpotDonalds/0.1 and the production URL.
MUSICBRAINZ_USER_AGENT=SpotDonalds/0.1 (you@example.com)

# Model id sent to the Vercel AI Gateway. Optional. Defaults to google/gemini-2.5-flash.
AI_MODEL=google/gemini-2.5-flash

# Gateway key for local development. Not required on Vercel: the project's OIDC
# token authenticates the gateway there. Never prefix with NEXT_PUBLIC_.
AI_GATEWAY_API_KEY=
